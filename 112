local function makeToggle(name, callback, initialState)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -4, 0, 36)
    local active = (initialState ~= nil) and initialState or false
    btn.BackgroundColor3 = active and Color3.fromRGB(18, 18, 24) or Color3.fromRGB(50, 20, 25)
    btn.Text = name .. (active and ": ON" or ": OFF")
    btn.TextColor3 = Color3.fromRGB(220, 220, 235)
    btn.TextSize = 11
    btn.Font = Enum.Font.GothamMedium
    btn.Parent = LeftPanel
    
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = btn
    
    btn.MouseButton1Click:Connect(function()
        active = not active
        callback(active)
        btn.Text = name .. (active and ": ON" or ": OFF")
        btn.BackgroundColor3 = active and Color3.fromRGB(18, 18, 24) or Color3.fromRGB(50, 20, 25)
    end)
    return btn
end

