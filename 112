-- Подсветка персонажа (Highlight Chams вместо уродливых коробок)
local function applyChams(player)
    if player == LocalPlayer then return end
    
    RunService.RenderStepped:Connect(function()
        local char = player.Character
        if not char then return end
        
        local highlight = char:FindFirstChild("DanHighlight")
        
        if settings.Chams and settings.SelectedTargets[player.Name] and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
            if not highlight then
                highlight = Instance.new("Highlight")
                highlight.Name = "DanHighlight"
                highlight.Adornee = char
                highlight.Parent = char
            end
            highlight.FillColor = Color3.fromRGB(0, 255, 120)
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.FillTransparency = 0.4
            highlight.OutlineTransparency = 0
            highlight.Enabled = true
        else
            if highlight then
                highlight.Enabled = false
            end
        end
    end)
end

for _, p in ipairs(Players:GetPlayers()) do applyChams(p) end
Players.PlayerAdded:Connect(applyChams)

-- Строгий Aimlock (работает только при зажатой ПКМ и наличии выбранной цели)
RunService.RenderStepped:Connect(function()
    if not settings.Aimlock then return end
    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local targetHead = nil
        
        for _, p in ipairs(Players:GetPlayers()) do
            if settings.SelectedTargets[p.Name] then
                if p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                    targetHead = p.Character.Head
                    break
                end
            end
        end
        
        if targetHead then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
        end
    end
end)

-- Умный Rapid Fire: стреляет ТОЛЬКО КОГДА ТЫ САМ СТРЕЛЬНУЛ (Зажал ЛКМ)
RunService.Heartbeat:Connect(function()
    if not settings.RapidFire then return end
    
    -- Проверяем, зажата ли левая кнопка мыши (ЛКМ)
    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
        local char = LocalPlayer.Character
        if not char then return end
        
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            pcall(function()
                tool:Activate()
            end)
        end
    end
end)
