-- Chams Highlight
local function applyChams(player)
    if player == LocalPlayer then return end
    
    RunService.RenderStepped:Connect(function()
        local char = player.Character
        if not char then return end
        
        local highlight = char:FindFirstChild("DanHighlightRage")
        
        if settings.Chams and settings.SelectedTargets[player.Name] and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
            if not highlight then
                highlight = Instance.new("Highlight")
                highlight.Name = "DanHighlightRage"
                highlight.Adornee = char
                highlight.Parent = char
            end
            highlight.FillColor = Color3.fromRGB(255, 0, 60)
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.FillTransparency = 0.1
            highlight.OutlineTransparency = 0
            highlight.Enabled = true
        else
            if highlight then
                highlight.Enabled = false
            end
        end
    end)
end

