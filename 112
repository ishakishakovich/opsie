-- Hotkeys Handler
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    
    if input.KeyCode == Enum.KeyCode.RightShift then
        MainFrame.Visible = not MainFrame.Visible
    end
    
    if input.KeyCode == settings.FlyKey and settings.FlyEnabled then
        settings.FlyActive = not settings.FlyActive
    end

    if input.KeyCode == settings.SpinKey then
        settings.Spinbot = not settings.Spinbot
        spinToggleBtn.Text = "Spinbot Mode (Key: V): " .. (settings.Spinbot and "ON" or "OFF")
        spinToggleBtn.BackgroundColor3 = settings.Spinbot and Color3.fromRGB(35, 20, 25) or Color3.fromRGB(20, 18, 24)
    end
    
    if input.KeyCode == settings.FastStopKey then
        local char = LocalPlayer.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                root.Velocity = Vector3.new(0, 0, 0)
                root.RotVelocity = Vector3.new(0, 0, 0)
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
        end
    end
end)

-- Spinbot & Anti-Aim Loop
local spinAngle = 0
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if settings.Spinbot then
        spinAngle = (spinAngle + settings.SpinSpeed) % 360
        root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, math.rad(spinAngle), 0)
    elseif settings.AntiAim then
        root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, math.rad(math.random(-180, 180)), 0)
    end
end)

-- Rainbow Chams & Hitbox Expander
RunService.RenderStepped:Connect(function()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local hum = char:FindFirstChild("Humanoid")
            local isDowned = char:FindFirstChild("KO") or char:FindFirstChild("Downed")
            
            -- Big Heads
            local head = char:FindFirstChild("Head")
            if head then
                if settings.BigHeads and settings.SelectedTargets[p.Name] and hum and hum.Health > 0 and not isDowned then
                    head.Size = Vector3.new(3.5, 3.5, 3.5)
                    head.CanCollide = false
                else
                    head.Size = Vector3.new(2, 1, 1)
                end
            end

            -- Rainbow Chams
            local highlight = char:FindFirstChild("WaveChams")
            if settings.Chams ~= false and settings.SelectedTargets[p.Name] and hum and hum.Health > 0 and not isDowned then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "WaveChams"
                    highlight.Adornee = char
                    highlight.Parent = char
                end
                if settings.RainbowChams then
                    highlight.FillColor = Color3.fromHSV(tick() % 5 / 5, 1, 1)
                else
                    highlight.FillColor = Color3.fromRGB(255, 80, 50)
                end
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.2
                highlight.OutlineTransparency = 0
                highlight.Enabled = true
            else
                if highlight then highlight.Enabled = false end
            end
        end
    end
end)

-- Fixed Hit Sound Listener
local trackedHealths = {}

local function setupHitSoundListener(player)
    if player == LocalPlayer then return end
    local function hookChar(char)
        local hum = char:WaitForChild("Humanoid", 5)
        if hum then
            trackedHealths[player.Name] = hum.Health
            hum.HealthChanged:Connect(function(newHealth)
                local oldHealth = trackedHealths[player.Name] or hum.MaxHealth
                if newHealth < oldHealth then
                    if settings.HitSound and settings.SelectedTargets[player.Name] and newHealth > 0 then
                        HitAudio.TimePosition = 0
                        HitAudio:Play()
                    end
                end
                trackedHealths[player.Name] = newHealth
            end)
        end
    end
    if player.Character then hookChar(player.Character) end
    player.CharacterAdded:Connect(hookChar)
end

for _, p in ipairs(Players:GetPlayers()) do setupHitSoundListener(p) end
Players.PlayerAdded:Connect(setupHitSoundListener)

