-- Fast Reload & Rapid Fire Loop
local lastShot = 0
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end

    if settings.FastReload then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local animator = humanoid:FindFirstChildOfClass("Animator")
            if animator then
                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                    local name = track.Name:lower()
                    if name:find("reload") or name:find("charge") then
                        track:AdjustSpeed(2.0 / settings.ReloadSpeed)
                    end
                end
            end
        end
        for _, v in ipairs(tool:GetDescendants()) do
            if v:IsA("NumberValue") or v:IsA("IntValue") then
                local name = v.Name:lower()
                if name:find("reloadtime") or name:find("cooldown") then
                    v.Value = settings.ReloadSpeed
                end
            end
        end
    end

    if settings.RapidFire and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
        local tickTime = tick()
        if tickTime - lastShot >= settings.RapidFireDelay then
            lastShot = tickTime
            pcall(function()
                tool:Activate()
            end)
        end
    end
end)

-- Smooth Fly Engine
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end
    local rootPart = char.HumanoidRootPart
    local humanoid = char.Humanoid

    if settings.FlyEnabled and settings.FlyActive then
        humanoid.PlatformStand = true
        local camCFrame = Camera.CFrame
        local moveVector = Vector3.new()

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVector = moveVector + camCFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVector = moveVector - camCFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVector = moveVector - camCFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVector = moveVector + camCFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveVector = moveVector + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveVector = moveVector - Vector3.new(0, 1, 0) end

        if moveVector.Magnitude > 0 then
            rootPart.Velocity = moveVector.Unit * settings.FlySpeed
        else
            rootPart.Velocity = Vector3.new(0, 0.1, 0)
        end
    else
        humanoid.PlatformStand = false
    end
end)
