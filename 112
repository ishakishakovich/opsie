local function updatePlayerList()
    for _, child in ipairs(PlayerListFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local pBtn = Instance.new("TextButton")
            pBtn.Size = UDim2.new(1, -6, 0, 32)
            
            local isSelected = settings.SelectedTargets[p.Name] == true
            pBtn.BackgroundColor3 = isSelected and Color3.fromRGB(20, 80, 50) or Color3.fromRGB(20, 20, 26)
            pBtn.Text = p.Name .. (isSelected and " [LOCKED]" or "")
            pBtn.TextColor3 = isSelected and Color3.fromRGB(100, 255, 150) or Color3.fromRGB(190, 190, 200)
            pBtn.TextSize = 11
            pBtn.Font = Enum.Font.Gotham
            pBtn.Parent = PlayerListFrame
            
            local pc = Instance.new("UICorner")
            pc.CornerRadius = UDim.new(0, 6)
            pc.Parent = pBtn
            
            pBtn.MouseButton1Click:Connect(function()
                if settings.SelectedTargets[p.Name] then
                    settings.SelectedTargets[p.Name] = nil
                    pBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
                    pBtn.Text = p.Name
                    pBtn.TextColor3 = Color3.fromRGB(190, 190, 200)
                else
                    settings.SelectedTargets[p.Name] = true
                    pBtn.BackgroundColor3 = Color3.fromRGB(20, 80, 50)
                    pBtn.Text = p.Name .. " [LOCKED]"
                    pBtn.TextColor3 = Color3.fromRGB(100, 255, 150)
                end
            end)
        end
    end
    PlayerListFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayoutRight.AbsoluteContentSize.Y + 10)
end

Players.PlayerAdded:Connect(updatePlayerList)
Players.PlayerRemoving:Connect(updatePlayerList)
