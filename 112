-- Hotkeys Handler
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    
    if input.KeyCode == Enum.KeyCode.RightShift then
        MainFrame.Visible = not MainFrame.Visible
    end
    
    if input.KeyCode == settings.FlyKey and settings.FlyEnabled then
        settings.FlyActive = not settings.FlyActive
    end

    if input.KeyCode == settings.SpinKey then
        settings.Spinbot = not settings.Spinbot
        spinToggleBtn.Text = "Spinbot Mode (Key: V): " .. (settings.Spinbot and "ON" or "OFF")
        spinToggleBtn.BackgroundColor3 = settings.Spinbot and Color3.fromRGB(18, 18, 24) or Color3.fromRGB(50, 20, 25)
    end
    
    if input.KeyCode == settings.FastStopKey then
        local char = LocalPlayer.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                root.Velocity = Vector3.new(0, 0, 0)
                root.RotVelocity = Vector3.new(0, 0, 0)
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
        end
    end
end)

-- Spinbot Execution
local spinAngle = 0
RunService.RenderStepped:Connect(function()
    if not settings.Spinbot then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        spinAngle = (spinAngle + settings.SpinSpeed) % 360
        root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, math.rad(spinAngle), 0)
    end
end)

-- Chams Highlight
local function applyChams(player)
    if player == LocalPlayer then return end
    
    RunService.RenderStepped:Connect(function()
        local char = player.Character
        if not char then return end
        
        local highlight = char:FindFirstChild("DanHighlightRage")
        
        if settings.Chams and settings.SelectedTargets[player.Name] and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
            if not highlight then
                highlight = Instance.new("Highlight")
                highlight.Name = "DanHighlightRage"
                highlight.Adornee = char
                highlight.Parent = char
            end
            highlight.FillColor = Color3.fromRGB(255, 0, 60)
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.FillTransparency = 0.1
            highlight.OutlineTransparency = 0
            highlight.Enabled = true
        else
            if highlight then highlight.Enabled = false end
        end
    end)
end

for _, p in ipairs(Players:GetPlayers()) do applyChams(p) end
Players.PlayerAdded:Connect(applyChams)

-- Targeted Hit Sound Listener
local lastHealths = {}

local function setupHealthListener(player)
    if player == LocalPlayer then return end
    
    local function connectChar(char)
        if not char then return end
        local hum = char:WaitForChild("Humanoid", 5)
        if hum then
            lastHealths[player.Name] = hum.Health
            hum.HealthChanged:Connect(function(newHealth)
                local oldHealth = lastHealths[player.Name] or hum.MaxHealth
                if newHealth < oldHealth then
                    local isLMBPressed = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
                    local isSelectedTarget = settings.SelectedTargets[player.Name] == true
                    
                    if settings.HitSound and isSelectedTarget and isLMBPressed then
                        HitAudio.TimePosition = 0
                        HitAudio:Play()
                    end
                end
                lastHealths[player.Name] = newHealth
            end)
        end
    end
    
    if player.Character then connectChar(player.Character) end
    player.CharacterAdded:Connect(connectChar)
end

for _, p in ipairs(Players:GetPlayers()) do setupHealthListener(p) end
Players.PlayerAdded:Connect(setupHealthListener)

-- Rage Snaplock & Camera FOV Lock Loop
RunService.RenderStepped:Connect(function()
    Camera.FieldOfView = settings.FOVValue

    if not settings.RageLock then return end
    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local targetHead = nil
        
        for _, p in ipairs(Players:GetPlayers()) do
            if settings.SelectedTargets[p.Name] then
                if p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                    targetHead = p.Character.Head
                    break
                end
            end
        end
        
        if targetHead then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
        end
    end
end)

-- Smooth Fly Engine
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end
    local rootPart = char.HumanoidRootPart
    local humanoid = char.Humanoid

    if settings.FlyEnabled and settings.FlyActive then
        humanoid.PlatformStand = true
        local camCFrame = Camera.CFrame
        local moveVector = Vector3.new()

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVector = moveVector + camCFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVector = moveVector - camCFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVector = moveVector - camCFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVector = moveVector + camCFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveVector = moveVector + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveVector = moveVector - Vector3.new(0, 1, 0) end

        if moveVector.Magnitude > 0 then
            rootPart.Velocity = moveVector.Unit * settings.FlySpeed
        else
            rootPart.Velocity = Vector3.new(0, 0.1, 0)
        end
    else
        humanoid.PlatformStand = false
    end
end)
