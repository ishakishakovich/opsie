-- ESP Implementation (ONLY for selected/locked targets)
local function createESP(player)
    if player == LocalPlayer then return end
    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = Color3.fromRGB(60, 240, 100)
    box.Thickness = 1.5
    box.Filled = false

    local nameText = Drawing.new("Text")
    nameText.Visible = false
    nameText.Color = Color3.fromRGB(255, 255, 255)
    nameText.Size = 13
    nameText.Center = true
    nameText.Outline = true

    RunService.RenderStepped:Connect(function()
        if not settings.ESP or not settings.SelectedTargets[player] then
            box.Visible = false
            nameText.Visible = false
            return
        end
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
            local vector, onScreen = Camera:WorldToViewportPoint(char.HumanoidRootPart.Position)
            if onScreen then
                local headPos = Camera:WorldToViewportPoint(char.Head.Position + Vector3.new(0, 0.5, 0))
                local legPos = Camera:WorldToViewportPoint(char.HumanoidRootPart.Position - Vector3.new(0, 3, 0))
                local height = math.abs(legPos.Y - headPos.Y)
                local width = (height / 2) * settings.StretchFactor -- Horizontal Stretch applied here
                
                box.Size = Vector2.new(width, height)
                box.Position = Vector2.new(vector.X - width / 2, headPos.Y)
                box.Visible = true

                nameText.Text = player.Name .. " [LOCKED]"
                nameText.Position = Vector2.new(vector.X, headPos.Y - 18)
                nameText.Visible = true
            else
                box.Visible = false
                nameText.Visible = false
            end
        else
            box.Visible = false
            nameText.Visible = false
        end
    end)
end

for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
Players.PlayerAdded:Connect(createESP)

-- Main Combat Loop (Strict Aimlock + Custom Fire Rate Modifier)
RunService.RenderStepped:Connect(function()
    if not settings.RageLock then return end
    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local targetHead = nil
        
        for p, active in pairs(settings.SelectedTargets) do
            if active then
                if p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                    targetHead = p.Character.Head
                    break
                end
            end
        end
        
        if targetHead then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
        end
    end
end)

-- Fire Rate Customizer Loop
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    
    for _, tool in ipairs({char:FindFirstChildOfClass("Tool"), LocalPlayer.Backpack:FindFirstChildOfClass("Tool")}) do
        if tool then
            for _, v in ipairs(tool:GetDescendants()) do
                if v:IsA("NumberValue") or v:IsA("IntValue") then
                    local name = v.Name:lower()
                    if name:find("cooldown") or name:find("firerate") or name:find("delay") or name:find("rate") then
                        v.Value = 0.1 / settings.FireRateMultiplier
                    end
                end
            end
        end
    end
end)
