-- Advanced ESP with Name Tags
local function createESP(player)
    if player == LocalPlayer then return end
    
    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = Color3.fromRGB(255, 60, 60)
    box.Thickness = 1.5
    box.Filled = false

    local nameText = Drawing.new("Text")
    nameText.Visible = false
    nameText.Color = Color3.fromRGB(255, 255, 255)
    nameText.Size = 14
    nameText.Center = true
    nameText.Outline = true

    RunService.RenderStepped:Connect(function()
        if not settings.ESP then
            box.Visible = false
            nameText.Visible = false
            return
        end
        
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
            local vector, onScreen = Camera:WorldToViewportPoint(char.HumanoidRootPart.Position)
            if onScreen then
                local headPos = Camera:WorldToViewportPoint(char.Head.Position + Vector3.new(0, 0.5, 0))
                local legPos = Camera:WorldToViewportPoint(char.HumanoidRootPart.Position - Vector3.new(0, 3, 0))
                
                local height = math.abs(legPos.Y - headPos.Y)
                local width = height / 2
                
                box.Size = Vector2.new(width, height)
                box.Position = Vector2.new(vector.X - width / 2, headPos.Y)
                box.Visible = true

                nameText.Text = player.Name
                nameText.Position = Vector2.new(vector.X, headPos.Y - 18)
                nameText.Visible = true
            else
                box.Visible = false
                nameText.Visible = false
            end
        else
            box.Visible = false
            nameText.Visible = false
        end
    end)
end

for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
Players.PlayerAdded:Connect(createESP)

-- Continuous Hold Aimlock (Runs every frame while RMB is held)
RunService.RenderStepped:Connect(function()
    if not settings.Aimlock then return end
    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local target, shortest = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
                local pos, onScreen = Camera:WorldToViewportPoint(p.Character.Head.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - UserInputService:GetMouseLocation()).Magnitude
                    if dist < shortest then
                        shortest = dist
                        target = p.Character.Head
                    end
                end
            end
        end
        if target then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
        end
    end
end)

-- Working Fast Reload (Patches ModuleScripts/Values & Remotes)
RunService.Heartbeat:Connect(function()
    if not settings.FastReload then return end
    local char = LocalPlayer.Character
    if not char then return end
    
    for _, tool in ipairs({char:FindFirstChildOfClass("Tool"), LocalPlayer.Backpack:FindFirstChildOfClass("Tool")}) do
        if tool then
            for _, v in ipairs(tool:GetDescendants()) do
                if v:IsA("NumberValue") or v:IsA("IntValue") then
                    local name = v.Name:lower()
                    if name:find("reload") or name:find("cooldown") or name:find("rate") or name:find("delay") then
                        v.Value = 0.01
                    end
                elseif v:IsA("ModuleScript") then
                    pcall(function()
                        local mod = require(v)
                        if type(mod) == "table" then
                            for k, _ in pairs(mod) do
                                local kl = tostring(k):lower()
                                if kl:find("reload") or kl:find("cooldown") then
                                    mod[k] = 0.01
                                end
                            end
                        end
                    end)
                end
            end
        end
    end
end)
