-- Smart Snaplock (Strictly releases on Downed / Knocked state for easy stomps)
RunService.RenderStepped:Connect(function()
    Camera.FieldOfView = settings.FOVValue

    if not settings.RageLock then return end
    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local bestHead = nil
        local shortestDistance = math.huge
        local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

        for _, p in ipairs(Players:GetPlayers()) do
            if settings.SelectedTargets[p.Name] then
                local char = p.Character
                if char then
                    local hum = char:FindFirstChild("Humanoid")
                    local head = char:FindFirstChild("Head")
                    local isKO = char:FindFirstChild("KO") or char:FindFirstChild("Downed") or (hum and hum.PlatformStand)
                    
                    -- Проверяем: жив, хп > 0, не в нокауте (не валяется)
                    if hum and head and hum.Health > 1 and not isKO then
                        if localRoot then
                            local dist = (localRoot.Position - head.Position).Magnitude
                            if dist < shortestDistance then
                                shortestDistance = dist
                                bestHead = head
                            end
                        end
                    end
                end
            end
        end

        if bestHead then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, bestHead.Position)
        end
    end
end)

-- Smooth Fly Engine
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end
    local rootPart = char.HumanoidRootPart
    local humanoid = char.Humanoid

    if settings.FlyEnabled and settings.FlyActive then
        humanoid.PlatformStand = true
        local camCFrame = Camera.CFrame
        local moveVector = Vector3.new()

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVector = moveVector + camCFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVector = moveVector - camCFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVector = moveVector - camCFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVector = moveVector + camCFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveVector = moveVector + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveVector = moveVector - Vector3.new(0, 1, 0) end

        if moveVector.Magnitude > 0 then
            rootPart.Velocity = moveVector.Unit * settings.FlySpeed
        else
            rootPart.Velocity = Vector3.new(0, 0.1, 0)
        end
    else
        humanoid.PlatformStand = false
    end
end)
