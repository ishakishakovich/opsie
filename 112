-- Skybox Changer Function
local function applySkybox()
    local existingSky = Lighting:FindFirstChildOfClass("Sky")
    if not settings.CustomSky then
        if existingSky and existingSky.Name == "DanCustomSky" then
            existingSky:Destroy()
        end
        return
    end

    if not existingSky or existingSky.Name ~= "DanCustomSky" then
        if existingSky then existingSky:Destroy() end
        existingSky = Instance.new("Sky")
        existingSky.Name = "DanCustomSky"
        existingSky.Parent = Lighting
    end

    local data = skyboxList[settings.CurrentSkyIndex]
    existingSky.SkyboxBk = data.Bk
    existingSky.SkyboxDn = data.Dn
    existingSky.SkyboxFt = data.Ft
    existingSky.SkyboxLf = data.Lf
    existingSky.SkyboxRt = data.Rt
    existingSky.SkyboxUp = data.Up
end

