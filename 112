local function updatePlayerList()
    for _, child in ipairs(PlayerListFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local pBtn = Instance.new("TextButton")
            pBtn.Size = UDim2.new(1, -4, 0, 30)
            local isSelected = settings.SelectedTargets[p] == true
            pBtn.BackgroundColor3 = isSelected and Color3.fromRGB(70, 30, 30) or Color3.fromRGB(26, 26, 36)
            pBtn.Text = p.Name .. (isSelected and " [LOCKED]" or "")
            pBtn.TextColor3 = Color3.fromRGB(210, 210, 220)
            pBtn.TextSize = 11
            pBtn.Font = Enum.Font.Gotham
            pBtn.Parent = PlayerListFrame
            
            local pc = Instance.new("UICorner")
            pc.CornerRadius = UDim.new(0, 4)
            pc.Parent = pBtn
            
            pBtn.MouseButton1Click:Connect(function()
                if settings.SelectedTargets[p] then
                    settings.SelectedTargets[p] = nil
                    pBtn.BackgroundColor3 = Color3.fromRGB(26, 26, 36)
                    pBtn.Text = p.Name
                else
                    settings.SelectedTargets[p] = true
                    pBtn.BackgroundColor3 = Color3.fromRGB(70, 30, 30)
                    pBtn.Text = p.Name .. " [LOCKED]"
                end
            end)
        end
    end
    PlayerListFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y)
end

Players.PlayerAdded:Connect(updatePlayerList)
Players.PlayerRemoving:Connect(updatePlayerList)
